{
  "name": "papergod",
  "version": "0.1.0",
  "type": "module",
  "description": "AI-powered local-first LaTeX writing platform and CLI",
  "keywords": [
    "latex",
    "academic-writing",
    "paper-writing",
    "ai",
    "editor",
    "cli",
    "overleaf",
    "research"
  ],
  "license": "MIT",
  "author": {
    "name": "SHENGYU LIU",
    "url": "https://github.com/LiuShengyu-Tech"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiuShengyu-Tech/papergod.git"
  },
  "bugs": {
    "url": "https://github.com/LiuShengyu-Tech/papergod/issues"
  },
  "homepage": "https://github.com/LiuShengyu-Tech/papergod#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "papergod": "./src/cli.js"
  },
  "files": [
    "src",
    "frontend",
    "public",
    "example/main.tex",
    "papergod-demo.png",
    "README.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "papergod": "node src/cli.js --resume",
    "build:web": "vite build --config frontend/vite.config.js",
    "prepack": "npm run build:web",
    "test": "node --test tests/api.test.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^5.65.16",
    "express": "^4.21.0",
    "lucide-react": "^1.31.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^4.8.69",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.3"
  }
}
