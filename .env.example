# Optional. Copy to .env to change the defaults used by docker-compose.yml.

# Host folder mounted into the container; any paper below it can be opened
# from Tools > Workspaces by its normal path. Default: your user folder
# (%USERPROFILE% on Windows, $HOME elsewhere). Narrow it to limit access.
# HOST_DIR=C:/Users/me

# Paper to open on start, as a normal host path inside HOST_DIR.
# Default: the paper you last selected in the app.
# PAPERGOD_WORKSPACE=C:/Users/me/Documents/my-paper

# Host port (published on 127.0.0.1 only).
# PAPERGOD_PORT=3000

# Linux only: your user and group id (`id -u`, `id -g`) so files stay yours.
# PAPERGOD_UID=1000
# PAPERGOD_GID=1000

# Install all of TeX Live instead of the default selection (~5 GB).
# TEXLIVE_PACKAGES=texlive-full
